{
  "name": "ip-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:xdb && vue-tsc --noEmit && vite build",
    "verify:xdb": "node scripts/verify-xdb.mjs public/data/ip2region.xdb",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "pages:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0",
    "wrangler": "^4.0.0"
  }
}
